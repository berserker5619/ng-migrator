{
  "name": "ng-migrator",
  "version": "1.1.0",
  "description": "Plans Angular upgrades one major version at a time (n-1 to n), with dependency blocker analysis and recommended fixes.",
  "keywords": [
    "angular",
    "upgrade",
    "migration",
    "ng-update",
    "dependencies",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/ng-migrator.git"
  },
  "bugs": {
    "url": "https://github.com/berserker5619/ng-migrator/issues"
  },
  "homepage": "https://github.com/berserker5619/ng-migrator#readme",
  "type": "module",
  "bin": {
    "ng-migrator": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "changeset": "changeset"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "semver": "^7.8.6",
    "typescript": "~6.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
